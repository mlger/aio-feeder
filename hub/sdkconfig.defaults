# AIO Feeder hub — defaults (Waveshare ESP32-S3-Touch-LCD-4.3B, 16 MB flash,
# 8 MB octal PSRAM). QEMU overrides these via sdkconfig.qemu.defaults.
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# M8a OTA (PLAN.md §7.6): a staged image boots in PENDING_VERIFY and must
# call esp_ota_mark_app_valid_cancel_rollback() within the health window
# (ota_service.cpp tick, CONFIG_AIO_OTA_CONFIRM_MS) — otherwise the
# bootloader marks it INVALID and falls back to the previous slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

CONFIG_LWIP_SNTP=y

# LVGL 9 (M4a hub UI, PLAN.md §8): 16-bit RGB565 + the dashboard fonts.
# The component comes from the registry via hub/main/idf_component.yml.
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
