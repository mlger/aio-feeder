# QEMU (ci.yml qemu-hub): the esp32s3 machine model has no octal
# PSRAM (failed init aborts the boot) and no Wi-Fi peripheral (esp_wifi init
# may hang or panic) — so this overlay tests the app, not the silicon.
# CONFIG_SPIRAM is not set
CONFIG_AIO_NO_RADIO=y

# M4a screenshot run: sim nodes + offscreen LVGL dashboard + AIO_SHOT
# markers (tools/qemu/capture.py dumps the framebuffer per marker).
CONFIG_AIO_UI_SHOT=y

# The default 64 KB lv_malloc pool fit six screens; the seventh (calibration
# wizard, M4b) tipped the first dashboard render into lv_memset(NULL)
# (StoreProhibited in lv_draw_sw_fill — the rounded-corner mask_buf
# allocation came back NULL). Static DRAM is the binding constraint here:
# the link overflowed by 11,136 B when the pool went +16 KB, so the feedloop
# dedup table (4 KB, REPL-only) is freed in this build and the pool rises to
# 72 KB. CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES is a no-op in 9.2.2 (it
# only feeds TLSF_MAX_POOL_SIZE). Hardware (PSRAM) is untouched.
CONFIG_LV_MEM_SIZE_KILOBYTES=70
# v0.6 (10 screens): the PIN pad moved to one lv_btnmatrix (was 12 buttons,
# ~1.5 KB of pool for widgets the shot never touches), which paid for the
# three new screens AND let the pool drop 72 -> 70 KB to cover the .bss
# growth of the settings/wizard snapshots (the link overflowed by 464 B).