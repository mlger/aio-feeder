# QEMU OTA selftest (ci.yml ota-selftest, tools/qemu/ota_run.py): the
# esp32s3 machine has no Wi-Fi (AIO_NO_RADIO) and no octal PSRAM (init
# aborts the boot — same reason sdkconfig.qemu.defaults sets it off), and
# the boot walk needs no UI: no AIO_UI_SHOT would still allow the hardware
# display (its Kconfig depends on !AIO_UI_SHOT and defaults to y), so it is
# disabled explicitly — display_hw.cpp compiles to inline no-ops. The
# health-confirm window shrinks to seconds so the walk fits one CI job.
# CONFIG_SPIRAM is not set
CONFIG_AIO_NO_RADIO=y
CONFIG_AIO_OTA_SELFTEST=y
CONFIG_AIO_OTA_CONFIRM_MS=5000
# CONFIG_AIO_HW_DISPLAY is not set

# Flash mode: DIO under QEMU — the QIO fast-read model shifts every
# response by two phantom bytes (see sdkconfig.qemu.defaults).
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
